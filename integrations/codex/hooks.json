{
  "description": "Optional Lore adapter. Replace /absolute/path/to/lore before reviewing this definition.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/lore/integrations/codex/lore_context.py",
            "timeout": 5,
            "additionalContextLimit": 1800,
            "statusMessage": "Preparing Lore workspace"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/lore/integrations/codex/lore_context.py",
            "timeout": 5,
            "additionalContextLimit": 1800,
            "statusMessage": "Discovering related Lore"
          }
        ]
      }
    ]
  }
}
